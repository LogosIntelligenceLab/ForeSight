# Use absolute paths on your own machine. Do not commit your local .env.
export OPENSCENE_DATA_ROOT=/path/to/NAVSIM
export NUPLAN_MAPS_ROOT=/path/to/NAVSIM/maps
export NUPLAN_MAP_VERSION=nuplan-maps-v1.0
export FORESIGHT_EPONA_CKPT=/path/to/epona_nuplan.pkl
export FORESIGHT_VAE_CKPT=/path/to/dcae_td_20000.pkl
export FORESIGHT_BACKBONE_CKPT=/path/to/resnet34/pytorch_model.bin
export FORESIGHT_PLAN_ANCHOR=/path/to/kmeans_navsim_traj_20.npy
# Optional planner initialization; leave unset to train without initialization:
# export FORESIGHT_PLANNER_PRETRAIN=/path/to/planner_pretrain.ckpt
# Full planner/world-model checkpoint used for evaluation:
export FORESIGHT_EVAL_CKPT=/path/to/foresight.ckpt
export NNODES=1
export NPROC_PER_NODE=1
export NODE_RANK=0
export MASTER_ADDR=127.0.0.1
export MASTER_PORT=29500
